# Web3Forms access key — routes the quote form to the Crystal Waters inbox.
#
# Committed deliberately. It is a NEXT_PUBLIC_ variable, so it is compiled into
# the client bundle and visible in the page source either way; Web3Forms treats
# the key as public by design and gates on the domain, not on secrecy. Keeping
# it here rather than only in CI means a build from any machine — or a GitHub
# Actions workflow whose env block someone forgets to update — still produces a
# working form instead of one that silently falls back to "not connected yet".
NEXT_PUBLIC_WEB3FORMS_KEY=d18e11c7-c970-4918-ad3b-0b9a77edce6a
